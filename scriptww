uis.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local pos = math.clamp((input.Position.X - speedBar.AbsolutePosition.X) / speedBar.AbsoluteSize.X, 0, 1)
        speedSlider.Position = UDim2.new(pos, -10, 0.5, -15)
        flySpeed = math.floor(pos * 350)
        speedLabel.Text = "PRĘDKOŚĆ LOTU: " .. flySpeed
    end
end)

-- LOGIKA FLY
runService.RenderStepped:Connect(function()
    if flying and bVel and bGyro then
        local dir = Vector3.new(0,0,0)
        local cf = camera.CFrame
        if uis:IsKeyDown(Enum.KeyCode.W) then dir = dir + cf.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.S) then dir = dir - cf.LookVector end
        if uis:IsKeyDown(Enum.KeyCode.A) then dir = dir - cf.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.D) then dir = dir + cf.RightVector end
        if uis:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
        if uis:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
        bVel.Velocity = dir * flySpeed
        bGyro.CFrame = cf
    end
end)

