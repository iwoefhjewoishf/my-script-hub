    b.TextSize = 18
    Instance.new("UICorner", b)
    b.MouseButton1Click:Connect(callback)
    parent.CanvasSize = UDim2.new(0,0,0, parent.UIListLayout.AbsoluteContentSize.Y + 60)
end

-- FUNKCJA DO TWORZENIA PRZEŁĄCZNIKÓW (TOGGLE)
local function AddToggle(text, parent, callback)
    local active = false
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1, -10, 0, 50)
    b.Text = text .. ": WYŁ"
    b.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 18
    Instance.new("UICorner", b)
    
    b.MouseButton1Click:Connect(function()
        active = not active
        b.Text = active and text .. ": WŁ" or text .. ": WYŁ"
        b.BackgroundColor3 = active and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
        callback(active)
    end)
    parent.CanvasSize = UDim2.new(0,0,0, parent.UIListLayout.AbsoluteContentSize.Y + 60)
end

