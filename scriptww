-- FUNKCJA TWORZENIA ZAKŁADKI
local function createTab(name, icon)
    local tab = Instance.new("TextButton", tabs)
    tab.Size = UDim2.new(0, 120, 1, 0)
    tab.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
    tab.Text = icon .. "  " .. name
    tab.TextColor3 = Color3.fromRGB(180, 180, 180)
    tab.TextSize = 16
    tab.Font = Enum.Font.GothamBold
    
    local tabCorner = Instance.new("UICorner", tab)
    tabCorner.CornerRadius = UDim.new(0, 8)
    
    local container = Instance.new("ScrollingFrame", contentFrame)
    container.Size = UDim2.new(1, -30, 1, -30)
    container.Position = UDim2.new(0, 15, 0, 15)
    container.BackgroundTransparency = 1
    container.ScrollBarThickness = 4
    container.ScrollBarImageColor3 = Color3.fromRGB(80, 80, 90)
    container.Visible = false
    container.AutomaticCanvasSize = Enum.AutomaticSize.Y
    container.CanvasSize = UDim2.new(0, 0, 0, 0)
    
    local containerLayout = Instance.new("UIListLayout", container)
    containerLayout.Padding = UDim.new(0, 10)
    containerLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    containerLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        container.CanvasSize = UDim2.new(0, 0, 0, containerLayout.AbsoluteContentSize.Y + 20)
    end)
    
    table.insert(tabsList, tab)
    tabContents[name] = container
    
    tab.MouseButton1Click:Connect(function()
        for _, t in ipairs(tabsList) do
            t.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            t.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        for _, cont in pairs(tabContents) do
            cont.Visible = false
        end
        tab.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
        tab.TextColor3 = Color3.fromRGB(255, 255, 255)
        container.Visible = true
    end)
    
    return container
end

