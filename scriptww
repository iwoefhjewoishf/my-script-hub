-- Kliknięcie
local function click(key)
    vim:SendKeyEvent(true, key, false, game)
    task.wait(0.02)
    vim:SendKeyEvent(false, key, false, game)
end

-- FAST COLLECT
local function makeFast(inst)
    if fastActive and inst:IsA("ProximityPrompt") then
        inst.HoldDuration = 0
    end
end

-- Pętla Collect (lekka)
local function startCollectLoop()
    collectLoop = coroutine.wrap(function()
        while collectActive do
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") and obj.KeyboardKeyCode == Enum.KeyCode.E then
                            local dist = (root.Position - obj.Parent.Position).Magnitude
                            if dist < 15 and (tick() - lastCollect > 0.2) then
                                lastCollect = tick()
                                click(Enum.KeyCode.E)
                                miscStatus.Text = "Zbieram..."
                            end
                        end
                    end
                end
            end
            task.wait(0.2)
        end
        miscStatus.Text = "Collect wyłączony"
    end)
    collectLoop()
end

-- Pętla Drill (rzadziej)
local function startDrillLoop()
    drillLoop = coroutine.wrap(function()
        while drillActive do
            local char = player.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                if root then
                    for _, obj in ipairs(workspace:GetDescendants()) do
                        if obj:IsA("ProximityPrompt") and obj.KeyboardKeyCode == Enum.KeyCode.F then
                            local dist = (root.Position - obj.Parent.Position).Magnitude
                            if dist < 15 and (tick() - lastDrill > 1.5) then
                                lastDrill = tick()
                                click(Enum.KeyCode.F)
                                miscStatus.Text = "Drilluję..."
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
        miscStatus.Text = "Drill wyłączony"
    end)
    drillLoop()
end

