local function AddButton(text, parent, callback)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(1, -10, 0, 50)
    b.Text = text
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
