local noFallActive = false
local noclipActive = false
local flying = false
local flySpeed = 50
local noclipConn = nil
local bVel = nil
local bGyro = nil

-- NO FALL DMG
local event = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2") and 
             game:GetService("ReplicatedStorage").BridgeNet2:FindFirstChild("dataRemoteEvent")

local oldHook
if event then
    oldHook = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if noFallActive and self == event and (method == "FireServer" or method == "fireServer") then
            if args[1] and args[1][2] == "\127" and args[1][1] and args[1][1].KevArgs and args[1][1].KevArgs[1] > 20 then
                args[1][1].KevArgs[1] = 0
                args[1][1].KevArgs[2] = false
                return oldHook(self, unpack(args))
            end
        end
        return oldHook(self, ...)
    end)
end

noFallToggle.MouseButton1Click:Connect(function()
    noFallActive = not noFallActive
    noFallToggle.BackgroundColor3 = noFallActive and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    noFallToggle.Text = noFallActive and "ON" or "OFF"
end)

-- NOCLIP
noclipToggle.MouseButton1Click:Connect(function()
    noclipActive = not noclipActive
    noclipToggle.BackgroundColor3 = noclipActive and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    noclipToggle.Text = noclipActive and "ON" or "OFF"
    
    if noclipActive then
        noclipConn = runService.Stepped:Connect(function()
            if noclipActive and player.Character then
                for _, v in pairs(player.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end)
    else
        if noclipConn then noclipConn:Disconnect() end
        task.wait(0.1)
        if player.Character then
            for _, v in pairs(player.Character:GetDescendants()) do
                if v:IsA("BasePart") then v.CanCollide = true end
            end
        end
    end
end)

-- FLY
local function toggleFly()
    flying = not flying
    flyToggle.BackgroundColor3 = flying and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    flyToggle.Text = flying and "ON" or "OFF"
    
    local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if flying and root then
        bVel = Instance.new("BodyVelocity", root)
        bVel.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bGyro = Instance.new("BodyGyro", root)
        bGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        player.Character.Humanoid.PlatformStand = true
    else
        if bVel then bVel:Destroy() end
        if bGyro then bGyro:Destroy() end
        if player.Character then player.Character.Humanoid.PlatformStand = false end
    end
end

flyToggle.MouseButton1Click:Connect(toggleFly)

uis.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.X then
        toggleFly()
    end
end)

