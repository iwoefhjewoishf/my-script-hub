-- NO FALL DMG
local event = game:GetService("ReplicatedStorage"):FindFirstChild("BridgeNet2") and 
             game:GetService("ReplicatedStorage").BridgeNet2:FindFirstChild("dataRemoteEvent")

local oldHook
if event then
    oldHook = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if noFallActive and self == event and (method == "FireServer" or method == "fireServer") then
            if args[1] and args[1][2] == "\127" and args[1][1] and args[1][1].KevArgs and args[1][1].KevArgs[1] > 20 then
                args[1][1].KevArgs[1] = 0
                args[1][1].KevArgs[2] = false
                return oldHook(self, unpack(args))
            end
        end
        return oldHook(self, ...)
    end)
end

